# ─────────────────────────────────────────────────────────────────────────────
# RouteWise Environment Configuration Template
# Copy this file to .env and configure your credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=4000

# MongoDB Connection String (Atlas SRV or local MongoDB)
# Can be named MONGO_URI or MONGODB_URI
MONGO_URI=mongodb://127.0.0.1:27017/routewise
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/routewise?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace-with-a-very-strong-secret-key-at-least-32-characters

# Primary AI Provider — OpenAI (GPT-4o-mini & Embeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI Provider Fallback 1 — Groq (Ultra-fast inference: openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# AI Provider Fallback 2 — Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# Live Search Provider — Google Serper API (for real-time train & route web extraction)
SERPER_API_KEY=

# Optional: Google Maps Places API for enhanced geocoding (Built-in offline fallback is active by default)
GOOGLE_MAPS_API_KEY=

# Optional: PNR Status API (required for live PNR lookup)
# Get a key from https://rapidapi.com/search/indian-railway or a licensed IRCTC API provider
IRCTC_PNR_API_KEY=
# RAPIDAPI_KEY=       # Alternative: RapidAPI key for train PNR endpoints

# Optional: Allowed CORS Origins (comma-separated, defaults to true in development)
# CORS_ORIGIN=http://localhost:5173,https://routewise.example.com

# ── Frontend (Vite) Environment Variables ──────────────────────────────────────
# Only needed when Vite development server is run separately without proxy.
# When Express serves the built dist/ directory, this is not needed.
# VITE_API_BASE_URL=http://localhost:4000
