PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/routewise
JWT_SECRET=replace-with-a-strong-secret
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Google Maps is OPTIONAL — fallback geocoding works without it
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
SERPER_API_KEY=
# CORS_ORIGIN=https://your-frontend-url.com

# ── Frontend (Vite) env vars ──────────────────────────────────────────────────
# Only needed when the frontend and backend are deployed on DIFFERENT origins.
# If the backend serves the Vite dist/ folder (recommended), leave this blank.
# VITE_API_BASE_URL=https://your-backend-url.com
